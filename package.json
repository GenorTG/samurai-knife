  },
  "private": true,
  "scripts": {
    "predev": "node scripts/prepare-ocr-assets.mjs && node scripts/prepare-sql-assets.mjs",
    "dev": "node scripts/serve.mjs dev",
    "prebuild": "node scripts/prepare-ocr-assets.mjs && node scripts/prepare-sql-assets.mjs",
    "build": "next build",
    "start": "node scripts/serve.mjs start",
    "lint": "eslint",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./tests/ts-resolve.mjs --test tests/*.test.mjs",
    "hooks": "bash scripts/install-hooks.sh",
    "accounts": "node scripts/accounts.mjs",
    "services": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./tests/ts-resolve.mjs scripts/services.ts",
    "storage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./tests/ts-resolve.mjs scripts/storage.ts",
    "email-lists": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=ExperimentalWarning --import ./tests/ts-resolve.mjs scripts/email-lists.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/server": "^2.2.0",
    "@noble/hashes": "^2.4.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/pol": "^1.0.0",
    "@xyflow/react": "^12.12.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "nodemailer": "^10.1.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "quickjs-emscripten-core": "^0.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sql.js": "^1.14.2",
    "tesseract.js": "^6.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
