# Copy to .env.local (gitignored) and fill in.

# Address the server binds to. Defaults to 127.0.0.1 (this machine only).
# Set to this host's Tailscale IPv4 to serve other tailnet machines; never 0.0.0.0.
KNIFE_HOST=127.0.0.1
KNIFE_PORT=3210
# Other names this app is opened by (machine name, LAN IP…), comma-separated. Loopback, KNIFE_HOST and the host of
# KNIFE_PUBLIC_URL are always allowed. Used for Next's allowedDevOrigins and the Host/Origin guard of every API route.
KNIFE_ALLOWED_HOSTS=

# Accounts (docs/ACCOUNTS.md). private (default) = owner-only, passwordless default account, accounts from
# `npm run accounts`. public = registration with a verified email, admin/user roles, no default account; run it behind an
# HTTPS reverse proxy on this machine and keep KNIFE_HOST on loopback. Set the owner's password + email with the CLI first.
KNIFE_AUTH_MODE=private
# Public base URL for links in mail (verification, reset); its host is added to the Host/Origin allow-list.
# Example: https://knife.example.com
KNIFE_PUBLIC_URL=
# Reverse-proxy addresses (IPs or CIDRs) whose X-Forwarded-For / X-Forwarded-Proto are trusted (client address for rate
# limits, Secure cookies). Example for a proxy on the same host: 127.0.0.1,::1. Empty = never trust forwarded headers.
KNIFE_TRUSTED_PROXIES=

# Key that seals every per-account file at rest (docs/ACCOUNTS.md "At rest"). Empty = $KNIFE_DATA_DIR/storage.key.
# On a public host point it outside the data directory (absolute path) and back it up separately.
KNIFE_STORAGE_KEY_FILE=

# Website studio (docs/WEBSITE-STUDIO.md). PageSpeed Insights key for Lighthouse scores (Google's anonymous quota is
# shared and usually used up); accounts may also set their own key. The API base URLs are for GitHub Enterprise / tests.
KNIFE_PSI_API_KEY=
KNIFE_GITHUB_API_URL=
KNIFE_PSI_API_URL=
# GitHub App (docs/GITHUB.md): credentials file (absolute, 0600; default $KNIFE_DATA_DIR/github-app.json), more
# callback bases registered when the app is created (comma list, e.g. the live address and the public domain), and
# the github.com base for GitHub Enterprise / tests.
KNIFE_GITHUB_APP_FILE=
KNIFE_GITHUB_EXTRA_BASES=
KNIFE_GITHUB_WEB_URL=
# Homepage shown publicly on the app's GitHub page (default KNIFE_PUBLIC_URL, else this server's address).
KNIFE_GITHUB_APP_HOMEPAGE=

# Account mail. outbox = .eml files in $KNIFE_DATA_DIR/mail-outbox/ (default in private mode, used by tests);
# smtp = deliver through the server below (default in public mode).
KNIFE_MAIL_TRANSPORT=
KNIFE_SMTP_HOST=
KNIFE_SMTP_PORT=587
# 1 = TLS from the first byte (port 465); otherwise STARTTLS when the server offers it.
KNIFE_SMTP_SECURE=
KNIFE_SMTP_USER=
KNIFE_SMTP_PASS=
KNIFE_SMTP_FROM="Samurai Knife <no-reply@knife.example.com>"

# Outbound requests a user can steer (provider base URL, job postings, company pages) go through src/lib/net/safe-fetch.ts:
# loopback/private/link-local/CGNAT (Tailscale)/ULA/metadata are always refused (except a public-mode admin's provider with
# `npm run accounts -- set-network <id> private`, and every provider in private mode). Also refuse these, comma-separated
# IPs or CIDRs: this server's public IPv4 (hairpin NAT to the router and port forwards) and the LAN's delegated global
# IPv6 prefix. The machine's own interface addresses (and the /64 of global IPv6 ones) are added automatically.
KNIFE_SSRF_DENY_CIDRS=

# Security headers (CSP, frame-ancestors, HSTS for an https KNIFE_PUBLIC_URL...) are on in public mode; 1 = also in private.
KNIFE_SECURITY_HEADERS=
# Extra origins the pages may frame and load scripts from (the office editor's origin is read from its sidecar state).
KNIFE_CSP_FRAME_ORIGINS=

# Python interpreter for server tools. Defaults to ../samurai-knife-py/venv/bin/python
# (the venv lives outside the repo — Turbopack must not traverse its symlinks).
KNIFE_PYTHON=

# Python work queue (src/lib/work-queue.ts). `light` = small fast jobs (sql engine), `heavy` = big file work (pdf).
# Concurrency = how many python processes run at once per lane; depth = how many may wait before new work gets 503 + Retry-After.
KNIFE_PY_LIGHT=4
KNIFE_PY_LIGHT_DEPTH=64
KNIFE_PY_HEAVY=1
KNIFE_PY_HEAVY_DEPTH=16
# Per account (running + queued) in each lane; beyond it 429. Free slots go round-robin between accounts.
KNIFE_PY_LIGHT_PER_ACCOUNT=8
KNIFE_PY_HEAVY_PER_ACCOUNT=3
# Resource limits per Python process (server/py/scripts/run_limited.py; 0 = none): address space per lane in MB, and the
# largest file one write may produce. CPU seconds are twice the run's timeout.
KNIFE_PY_MEM_MB_LIGHT=1024
KNIFE_PY_MEM_MB_HEAVY=3072
KNIFE_PY_FSIZE_MB=2048

# Async jobs (POST /api/pdf?async=1): in-memory, per account.
# Seconds a finished job (and its result file) is kept before it is reaped; DELETE /api/jobs/<id> reaps it at once.
KNIFE_JOB_TTL_SEC=600
# Cap on scratch bytes (uploads + results) held by live async jobs, and on one result file.
KNIFE_JOBS_MAX_MB=2048
KNIFE_JOB_RESULT_MAX_MB=512
# One account's share: live jobs, and scratch MB (default a quarter of KNIFE_JOBS_MAX_MB).
KNIFE_JOBS_PER_ACCOUNT=50
# KNIFE_JOBS_ACCOUNT_MAX_MB=512

# Database course runs (src/lib/learn/sql/slots.ts): in flight per account, and on the whole server (below the
# learner role's CONNECTION LIMIT 20).
KNIFE_LEARN_RUNS_PER_ACCOUNT=1
KNIFE_LEARN_MAX_RUNS=12
# Largest /api/pdf request (streamed to disk while it arrives, never held in memory); never above KNIFE_JOBS_MAX_MB.
KNIFE_PDF_UPLOAD_MAX_MB=512

# Sidecars: IPs the office editor's request filter may fetch although private (empty: none; the app's own signed
# document and callback URLs do not need it).
KNIFE_SIDECAR_ALLOW_IPS=
