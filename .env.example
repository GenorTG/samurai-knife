# Copy to .env.local (gitignored) and fill in.

# Address the server binds to. Defaults to 127.0.0.1 (this machine only).
# Set to this host's Tailscale IPv4 to serve other tailnet machines; never 0.0.0.0.
KNIFE_HOST=127.0.0.1
KNIFE_PORT=3210
# Other names this app is opened by (machine name, LAN IP…), comma-separated. Loopback and KNIFE_HOST are always allowed.
# Used for Next's allowedDevOrigins and the Host/Origin guard of every API route.
KNIFE_ALLOWED_HOSTS=

# Python interpreter for server tools. Defaults to ../samurai-knife-py/venv/bin/python
# (the venv lives outside the repo — Turbopack must not traverse its symlinks).
KNIFE_PYTHON=

# Python work queue (src/lib/work-queue.ts). `light` = small fast jobs (sql engine), `heavy` = big file work (pdf).
# Concurrency = how many python processes run at once per lane; depth = how many may wait before new work gets 503 + Retry-After.
KNIFE_PY_LIGHT=4
KNIFE_PY_LIGHT_DEPTH=64
KNIFE_PY_HEAVY=1
KNIFE_PY_HEAVY_DEPTH=16

# Async jobs (POST /api/pdf?async=1): in-memory, per account.
# Seconds a finished job (and its result file) is kept before it is reaped; DELETE /api/jobs/<id> reaps it at once.
KNIFE_JOB_TTL_SEC=600
# Cap on scratch bytes (uploads + results) held by live async jobs, and on one result file.
KNIFE_JOBS_MAX_MB=2048
KNIFE_JOB_RESULT_MAX_MB=512
