    "office": {
        "service": "documentserver",
        "image_prefix": "ghcr.io/euro-office/documentserver:",
        "prepare": ["documentserver-generate-allfonts.sh"],
        "assets_target": "/var/www/euro-office/documentserver/sdkjs-plugins",
        "cap_add": frozenset({"CHOWN", "DAC_OVERRIDE", "FOWNER", "KILL", "SETGID", "SETUID"}),
        "pids_max": 1024,
        "mem_max": 3 * 1024 ** 3,
    },
    "learn-db": {
        "service": "postgres",
        "image_prefix": "postgis/postgis:",
        "prepare": None,
        "assets_target": None,
        "cap_add": frozenset({"CHOWN", "DAC_OVERRIDE", "FOWNER", "SETGID", "SETUID"}),
        "pids_max": 256,
        "mem_max": 1024 ** 3,
    },
    # The ArtCraft apps: nginx (uid 101, no capabilities) serving the seven unpacked web builds plus its generated
    # nginx.conf from the bundle's assets (~0.5 GB, hence its own asset cap).
    "craft": {
        "service": "nginx",
        "image_prefix": "nginxinc/nginx-unprivileged:",
        "prepare": None,
        "assets_target": "/srv/craft",
        "cap_add": frozenset(),
