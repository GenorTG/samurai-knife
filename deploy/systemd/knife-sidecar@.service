# One knife-sidecar-helper run per accepted connection (knife-sidecar.socket, Accept=yes). It runs docker compose as
# root on root-installed bundles only; the request is one allow-listed verb + sidecar id (deploy/sidecar-helper/).
# Install: /etc/systemd/system/knife-sidecar@.service. Placeholder: @HELPER@ (e.g. /usr/local/libexec/samurai-knife/knife-sidecar-helper).

[Unit]
Description=Smart Knife sidecar helper (connection %i)
After=docker.service
Requires=docker.service
CollectMode=inactive-or-failed

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 -I @HELPER@ serve
StandardInput=socket
StandardOutput=socket
StandardError=journal
# Longest verb is pull (30 min).
RuntimeMaxSec=35min
# Lock files and the docker CLI's config/home; shared by all instances, so it survives an instance's exit.
RuntimeDirectory=knife-sidecar
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# The helper only talks to /run/docker.sock: no network, no capabilities (root owns the docker socket), read-only system.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
ProtectSystem=strict
# Writable: its runtime dir, and root's copy of the Craft apps' static content (the `content` verb swaps app folders
# in there; the container mounts it read-only). Nothing else under /etc: bundles are installed by the root CLI `sync`,
# which runs outside this unit. install.sh creates the folder; `-` keeps the unit startable on a host without it.
ReadWritePaths=/run/knife-sidecar -/etc/samurai-knife/sidecars/craft-content
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
MemoryMax=256M
TasksMax=64
