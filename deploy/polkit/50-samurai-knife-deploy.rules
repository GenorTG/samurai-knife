// Smart Knife: the updater account may restart (only restart) the app service. Installed by deploy/install.sh into
// /etc/polkit-1/rules.d/ (root:root 0644). @SERVICE@ is substituted.
polkit.addRule(function (action, subject) {
  if (action.id == "org.freedesktop.systemd1.manage-units" &&
      action.lookup("unit") == "@SERVICE@" &&
      action.lookup("verb") == "restart" &&
      subject.user == "knife-deploy") {
    return polkit.Result.YES;
  }
});
