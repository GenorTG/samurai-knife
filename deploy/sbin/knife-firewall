#!/usr/bin/python3 -I
"""knife-firewall: the host's default-drop INPUT policy, rendered from one declarative file, applied lockout-safe.

Threat model: every service that listens on a wildcard address is reachable from the LAN (and from the internet when the
router forwards it); this table drops what the config does not name. It is a separate nftables table (`inet
knife_host`), so Docker's own tables survive (never `flush ruleset`). Docker-published ports are FORWARD traffic and
are governed by DOCKER-USER (knife-docker-user), not by this table; container -> host traffic (NPM -> the app, sidecar
callbacks) is INPUT and is allowed here only from the proxy address / sidecar networks to the listed ports.

  knife-firewall render                    print the ruleset
  knife-firewall check                     render + `nft -c` (root, or inside `unshare -rn` as a normal user)
  knife-firewall preflight                 what would each listening socket lose? (no root needed)
  knife-firewall apply [--timeout N]       root: apply, then roll back automatically after N s (default 120)
  knife-firewall confirm [--no-persist]    root, from a NEW ssh/tailscale session: keep it (and write it to
                                           /etc/nftables.d/knife-host.nft, which knife-firewall.service loads at
                                           boot; never through a stock /etc/nftables.conf: its `flush ruleset`
                                           would wipe Docker's rules on a reload)
  knife-firewall load                      root: load the persisted table (what knife-firewall.service runs)
  knife-firewall rollback                  root: restore the previous table (or remove ours)
  knife-firewall status

Config: /etc/samurai-knife/firewall.conf (KEY=VALUE, see deploy/firewall/firewall.conf.example). Non-root runs may
point KNIFE_FIREWALL_CONF elsewhere. docs/DEPLOY.md "Host firewall". Tests: tests/deploy_firewall.test.mjs.
"""

import ipaddress
import json
import os
import re
import shutil
import subprocess
import sys

TABLE = "knife_host"
STATE_DIR = "/run/knife-firewall"
PERSIST = "/etc/nftables.d/knife-host.nft"
ROLLBACK_UNIT = "knife-firewall-rollback"
CONF_PATH = "/etc/samurai-knife/firewall.conf"
DEFAULTS = {
    "LAN_IF": "",
    "LAN_CIDR4": "",
    "LAN_CIDR6": "",
    "TAILSCALE_IF": "tailscale0",
    "TAILSCALE_TCP": "all",
    "TAILSCALE_UDP": "all",
    "LAN_TCP": "",
    "LAN_UDP": "",
    "INTERNET_TCP": "",
    "INTERNET_UDP": "",
    "DOCKER_IFS": "docker0 br-*",
    "PROXY_IP4": "",
    "PROXY_TCP": "",
    "SIDECAR_TCP": "",
    "DOCKER_TCP": "",
    "DOCKER_UDP": "",
    "LOG_DROPS": "yes",
}
IFACE = re.compile(r"^[A-Za-z0-9._-]{1,14}\*?$")


class FirewallError(Exception):
    pass


def load_conf():
    path = CONF_PATH
    if os.geteuid() != 0 and os.environ.get("KNIFE_FIREWALL_CONF"):
        path = os.environ["KNIFE_FIREWALL_CONF"]
    conf = dict(DEFAULTS)
    with open(path, encoding="utf-8") as handle:
        if os.geteuid() == 0:
            info = os.fstat(handle.fileno())
            if info.st_uid != 0 or info.st_mode & 0o022:
                raise FirewallError(f"{path} must be root-owned and not group/world-writable")
        for raw in handle:
            line = raw.split("#", 1)[0].strip()
            if not line:
                continue
            key, sep, value = line.partition("=")
            key = key.strip()
            if not sep or key not in DEFAULTS:
                raise FirewallError(f"unknown setting: {line}")
            conf[key] = value.strip().strip('"').strip("'")
    return conf


def ports(value, name):
    if value.strip() == "all":
        return "all"
    out = []
    for item in value.split():
        if not re.fullmatch(r"\d{1,5}(-\d{1,5})?", item):
            raise FirewallError(f"{name}: bad port {item!r}")
        for part in item.split("-"):
            if not 1 <= int(part) <= 65535:
                raise FirewallError(f"{name}: port out of range {item!r}")
        out.append(item)
    return out


def cidr(value, version, name):
    if not value:
        return None
    net = ipaddress.ip_network(value, strict=False)
    if net.version != version:
        raise FirewallError(f"{name}: not IPv{version}")
    return str(net)


def iface(value, name):
    if value and not IFACE.match(value):
        raise FirewallError(f"{name}: bad interface name {value!r}")
    return value


def parsed(conf):
    p = {
        "lan_if": iface(conf["LAN_IF"], "LAN_IF"),
        "lan4": cidr(conf["LAN_CIDR4"], 4, "LAN_CIDR4"),
        "lan6": cidr(conf["LAN_CIDR6"], 6, "LAN_CIDR6"),
        "ts_if": iface(conf["TAILSCALE_IF"], "TAILSCALE_IF"),
        "docker_ifs": [iface(item, "DOCKER_IFS") for item in conf["DOCKER_IFS"].split()],
        "proxy4": str(ipaddress.IPv4Address(conf["PROXY_IP4"])) if conf["PROXY_IP4"] else None,
        "log": conf["LOG_DROPS"].lower() in ("yes", "1", "true"),
    }
    for key in ("TAILSCALE_TCP", "TAILSCALE_UDP", "LAN_TCP", "LAN_UDP", "INTERNET_TCP", "INTERNET_UDP", "PROXY_TCP", "SIDECAR_TCP", "DOCKER_TCP", "DOCKER_UDP"):
        p[key.lower()] = ports(conf[key], key)
    if not p["lan_if"]:
        raise FirewallError("LAN_IF is required (the interface the router and the LAN reach this host on)")
    if p["proxy_tcp"] and not p["proxy4"]:
        raise FirewallError("PROXY_TCP needs PROXY_IP4")
    return p


def port_set(items):
    return "{ " + ", ".join(items) + " }"


def render(conf):
    p = parsed(conf)
    rules = [
        "ct state established,related accept",
        "ct state invalid drop",
        'iif "lo" accept',
        # Path MTU discovery and error reporting must pass; echo is rate-limited.
        "icmp type { destination-unreachable, time-exceeded, parameter-problem } accept",
        "icmp type echo-request limit rate 5/second accept",
        # IPv6 neighbour discovery / router advertisements are link-local and mandatory.
        "icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert, mld-listener-query } accept",
        "icmpv6 type echo-request limit rate 5/second accept",
        # DHCP replies to this host's client.
        f'iifname "{p["lan_if"]}" udp sport 67 udp dport 68 accept',
        f'iifname "{p["lan_if"]}" ip6 saddr fe80::/10 udp sport 547 udp dport 546 accept',
    ]
    if p["ts_if"]:
        for proto in ("tcp", "udp"):
            allowed = p[f"tailscale_{proto}"]
            if allowed == "all":
                rules.append(f'iifname "{p["ts_if"]}" meta l4proto {proto} accept')
            elif allowed:
                rules.append(f'iifname "{p["ts_if"]}" {proto} dport {port_set(allowed)} accept')
    for proto in ("tcp", "udp"):
        lan = p[f"lan_{proto}"]
        if lan and lan != "all":
            if p["lan4"]:
                rules.append(f'iifname "{p["lan_if"]}" ip saddr {p["lan4"]} {proto} dport {port_set(lan)} accept')
            if p["lan6"]:
                rules.append(f'iifname "{p["lan_if"]}" ip6 saddr {p["lan6"]} {proto} dport {port_set(lan)} accept')
        internet = p[f"internet_{proto}"]
        if internet and internet != "all":
            rules.append(f'iifname "{p["lan_if"]}" {proto} dport {port_set(internet)} accept')
    for name in p["docker_ifs"]:
        if p["proxy_tcp"] and p["proxy_tcp"] != "all":
            rules.append(f'iifname "{name}" ip saddr {p["proxy4"]} tcp dport {port_set(p["proxy_tcp"])} accept')
        if p["sidecar_tcp"] and p["sidecar_tcp"] != "all":
            rules.append(f'iifname "{name}" ip saddr @sidecar_nets tcp dport {port_set(p["sidecar_tcp"])} accept')
        for proto in ("tcp", "udp"):
            allowed = p[f"docker_{proto}"]
            if allowed and allowed != "all":
                rules.append(f'iifname "{name}" {proto} dport {port_set(allowed)} accept')
    if p["log"]:
        rules.append('limit rate 10/minute burst 20 packets log prefix "knife-host-drop " level info')
    body = "\n".join(f"\t\t{rule}" for rule in rules)
    return (
        "# Generated by knife-firewall from /etc/samurai-knife/firewall.conf. Do not edit; never add `flush ruleset`.\n"
        f"table inet {TABLE} {{}}\n"
        f"delete table inet {TABLE}\n"
        f"table inet {TABLE} {{\n"
        "\t# Sidecar networks (kept in sync by knife-docker-user): may reach SIDECAR_TCP on this host.\n"
        "\tset sidecar_nets {\n\t\ttype ipv4_addr\n\t\tflags interval\n\t}\n\n"
        "\tchain input {\n"
        "\t\ttype filter hook input priority filter; policy drop;\n"
        f"{body}\n"
        "\t}\n"
        "}\n"
    )


# ------------------------------------------------------------------------------------------------ preflight


def host_addresses():
    """interface -> [ip, ...] from `ip -j addr` (no root needed)."""
    out = subprocess.run(["ip", "-j", "addr"], capture_output=True, text=True, check=True).stdout
    result = {}
    for link in json.loads(out):
        result[link["ifname"]] = [info["local"] for info in link.get("addr_info", [])]
    return result


def listeners():
    out = subprocess.run(["ss", "-H", "-tulpn"], capture_output=True, text=True, check=True).stdout
    rows = []
    for line in out.splitlines():
        fields = line.split()
        if len(fields) < 5:
            continue
        proto, local = fields[0], fields[4]
        process = re.search(r'users:\(\("([^"]+)"', line)
        host, _sep, port = local.rpartition(":")
        host = host.strip("[]").split("%")[0]
        if not port.isdigit():
            continue
        rows.append({"proto": proto, "host": host, "port": int(port), "process": process.group(1) if process else "?"})
    return rows


def docker_published():
    """{(host_ip, port)} published by containers (FORWARD path, DOCKER-USER), plus the container name."""
    try:
        out = subprocess.run(["docker", "ps", "--format", "{{.Names}}\t{{.Ports}}"], capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    published = {}
    for line in out.splitlines():
        name, _tab, ports_text = line.partition("\t")
        for match in re.finditer(r"(\[?[0-9a-f:.]+\]?):(\d+)->", ports_text):
            published[(match.group(1).strip("[]"), int(match.group(2)))] = name
    return published


def port_allowed(spec, port):
    if spec == "all":
        return True
    for item in spec or []:
        low, _sep, high = item.partition("-")
        if int(low) <= port <= int(high or low):
            return True
    return False


def zones_for(host, addrs, p):
    """Zones from which a socket bound to `host` is reachable without a firewall."""
    wildcard = host in ("0.0.0.0", "::", "*")
    zones = set()
    def owns(ifname):
        return wildcard or host in addrs.get(ifname, [])
    if owns(p["lan_if"]):
        zones |= {"lan", "internet"}
    if p["ts_if"] and owns(p["ts_if"]):
        zones.add("tailscale")
    for pattern in p["docker_ifs"]:
        names = [n for n in addrs if (n.startswith(pattern[:-1]) if pattern.endswith("*") else n == pattern)]
        if any(owns(n) for n in names):
            zones.add("containers")
    return zones


def allowed_after(zone, proto, port, p):
    proto = "udp" if proto.startswith("udp") else "tcp"
    if zone == "tailscale":
        return port_allowed(p[f"tailscale_{proto}"], port)
    if zone == "lan":
        return port_allowed(p[f"lan_{proto}"], port) or port_allowed(p[f"internet_{proto}"], port)
    if zone == "internet":
        return port_allowed(p[f"internet_{proto}"], port)
    if zone == "containers":
        return (proto == "tcp" and (port_allowed(p["proxy_tcp"], port) or port_allowed(p["sidecar_tcp"], port))) or port_allowed(p[f"docker_{proto}"], port)
    return False


def preflight(conf):
    p = parsed(conf)
    addrs = host_addresses()
    published = docker_published()
    cut, kept, via_docker = [], [], []
    for row in listeners():
        zones = zones_for(row["host"], addrs, p)
        if not zones:
            continue
        label = f'{row["proto"]} {row["host"]}:{row["port"]} ({row["process"]})'
        key = (row["host"] if row["host"] not in ("*",) else "0.0.0.0", row["port"])
        if key in published or (("0.0.0.0", row["port"]) in published and row["host"] in ("0.0.0.0", "::", "*")):
            via_docker.append(f"{label} container {published.get(key) or published.get(('0.0.0.0', row['port']))}: external access = DOCKER-USER (knife-docker-user); from containers via docker-proxy = this table")
        lost = sorted(zone for zone in zones if not allowed_after(zone, row["proto"], row["port"], p))
        keep = sorted(zone for zone in zones if allowed_after(zone, row["proto"], row["port"], p))
        if lost:
            cut.append(f"CUT  {label:58} loses: {', '.join(lost)}" + (f"   keeps: {', '.join(keep)}" if keep else ""))
        else:
            kept.append(f"KEEP {label:58} {', '.join(keep)}")
    print("Listening sockets this ruleset would block (zones = where they are reachable from today):")
    print("\n".join(sorted(set(cut))) or "  (none)")
    print("\nStill reachable:")
    print("\n".join(sorted(set(kept))) or "  (none)")
    if via_docker:
        print("\nDocker-published (not filtered by this table for outside clients):")
        print("\n".join(sorted(set(via_docker))))
    session = os.environ.get("SSH_CONNECTION", "").split()
    blocked = False
    if len(session) == 4:
        client, server_ip, server_port = session[0], session[2], int(session[3])
        zone = "tailscale" if p["ts_if"] and server_ip in addrs.get(p["ts_if"], []) else "lan"
        blocked = not allowed_after(zone, "tcp", server_port, p)
        verdict = "BLOCKED for new connections" if blocked else "allowed"
        print(f"\nThis SSH session: {client} -> {server_ip}:{server_port} ({zone}): {verdict}")
        if blocked:
            print("WARNING: a new SSH connection over this path would be refused; confirm from the other path.")
    return 1 if blocked else 0


# ------------------------------------------------------------------------------------------------ apply / confirm


def need_root():
    if os.geteuid() != 0:
        raise FirewallError("run as root")


def nft(*args, stdin=None):
    return subprocess.run(["nft", *args], input=stdin, capture_output=True, text=True)


def check(conf):
    text = render(conf)
    cmd = ["nft", "-c", "-f", "-"] if os.geteuid() == 0 else ["unshare", "-rn", "nft", "-c", "-f", "-"]
    result = subprocess.run(cmd, input=text, capture_output=True, text=True)
    if result.returncode != 0:
        raise FirewallError("nft -c refused the ruleset:\n" + result.stderr)
    print("nft -c: ruleset OK")
    return 0


def apply(conf, timeout):
    need_root()
    if not 30 <= timeout <= 900:
        raise FirewallError("--timeout must be 30..900 seconds")
    check(conf)
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    previous = nft("list", "table", "inet", TABLE)
    with open(os.path.join(STATE_DIR, "previous.nft"), "w", encoding="utf-8") as handle:
        handle.write(previous.stdout if previous.returncode == 0 else "")
    with open(os.path.join(STATE_DIR, "new.nft"), "w", encoding="utf-8") as handle:
        handle.write(render(conf))
    with open(os.path.join(STATE_DIR, "apply-session"), "w", encoding="utf-8") as handle:
        handle.write(os.environ.get("SSH_CONNECTION", "local"))
    subprocess.run(["systemctl", "stop", f"{ROLLBACK_UNIT}.timer"], capture_output=True)
    subprocess.run(["systemctl", "reset-failed", f"{ROLLBACK_UNIT}.service"], capture_output=True)
    armed = subprocess.run(["systemd-run", f"--unit={ROLLBACK_UNIT}", f"--on-active={timeout}", "--timer-property=AccuracySec=1s",
                            os.path.realpath(sys.argv[0]), "rollback"], capture_output=True, text=True)
    if armed.returncode != 0:
        raise FirewallError("could not arm the rollback timer; nothing applied:\n" + armed.stderr)
    result = nft("-f", os.path.join(STATE_DIR, "new.nft"))
    if result.returncode != 0:
        subprocess.run(["systemctl", "stop", f"{ROLLBACK_UNIT}.timer"], capture_output=True)
        raise FirewallError("nft refused the ruleset; nothing applied:\n" + result.stderr)
    # The sidecar set starts empty: refill it now if knife-docker-user is installed.
    if shutil.which("knife-docker-user"):
        subprocess.run(["knife-docker-user", "apply"], capture_output=True)
    print(f"APPLIED. It is rolled back automatically in {timeout} s.")
    print("Now open a NEW ssh session (or one over the other path: Tailscale vs LAN) and run there:")
    print("    sudo knife-firewall confirm")
    print("If you cannot get in, wait: the old state comes back by itself.")
    return 0


def confirm(persist):
    need_root()
    marker = os.path.join(STATE_DIR, "apply-session")
    if not os.path.exists(marker):
        raise FirewallError("nothing to confirm (no apply in progress)")
    with open(marker, encoding="utf-8") as handle:
        applied_from = handle.read().strip()
    here = os.environ.get("SSH_CONNECTION", "local")
    if here == applied_from and "--same-session" not in sys.argv:
        raise FirewallError("confirm from a NEW session: this is the one that applied the rules, which proves nothing "
                            "about new connections (override: --same-session)")
    subprocess.run(["systemctl", "stop", f"{ROLLBACK_UNIT}.timer"], check=True)
    os.unlink(marker)
    if persist:
        os.makedirs(os.path.dirname(PERSIST), mode=0o755, exist_ok=True)
        shutil.copyfile(os.path.join(STATE_DIR, "new.nft"), PERSIST + ".tmp")
        os.chmod(PERSIST + ".tmp", 0o644)
        os.replace(PERSIST + ".tmp", PERSIST)
        print(f"confirmed; persisted to {PERSIST} (loaded at boot by knife-firewall.service; enable it once: systemctl enable knife-firewall.service)")
    else:
        print("confirmed (not persisted: a reboot returns to the boot-time rules)")
    return 0


def rollback():
    need_root()
    previous_path = os.path.join(STATE_DIR, "previous.nft")
    previous = open(previous_path, encoding="utf-8").read() if os.path.exists(previous_path) else ""
    if previous.strip():
        result = nft("-f", "-", stdin=f"table inet {TABLE} {{}}\ndelete table inet {TABLE}\n{previous}")
    else:
        result = nft("delete", "table", "inet", TABLE)
    marker = os.path.join(STATE_DIR, "apply-session")
    if os.path.exists(marker):
        os.unlink(marker)
    print("rolled back" if result.returncode == 0 else f"rollback: {result.stderr.strip()}")
    return result.returncode


def load():
    need_root()
    if not os.path.exists(PERSIST):
        print(f"{PERSIST} missing: nothing to load (apply + confirm first)")
        return 0
    result = nft("-f", PERSIST)
    if result.returncode != 0:
        raise FirewallError("nft refused the persisted table:\n" + result.stderr)
    if shutil.which("knife-docker-user"):
        subprocess.run(["knife-docker-user", "apply"], capture_output=True)
    print(f"loaded {PERSIST}")
    return 0


def status():
    result = nft("list", "table", "inet", TABLE)
    print(result.stdout or result.stderr)
    subprocess.run(["systemctl", "list-timers", f"{ROLLBACK_UNIT}.timer", "--no-pager"])
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    try:
        mode = argv[0]
        if mode == "rollback":
            return rollback()
        if mode == "status":
            return status()
        if mode == "confirm":
            return confirm("--no-persist" not in argv)
        if mode == "load":
            return load()
        conf = load_conf()
        if mode == "render":
            sys.stdout.write(render(conf))
            return 0
        if mode == "check":
            return check(conf)
        if mode == "preflight":
            return preflight(conf)
        if mode == "apply":
            timeout = 120
            if "--timeout" in argv:
                timeout = int(argv[argv.index("--timeout") + 1])
            return apply(conf, timeout)
        raise FirewallError(f"unknown mode {mode}")
    except (FirewallError, ValueError, OSError) as error:
        print(f"knife-firewall: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
