/tests/**/artifacts/
/tests/**/*.log
/tests/**/*-report.md
*.trace.zip

# local data: accounts, CV, documents and databases live in $KNIFE_DATA_DIR (outside the repo); never commit a copy
/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.duckdb
accounts.json
*.local.json
*.local.md

# private documents and exports dropped into the checkout by hand
*.docx
*.xlsx
*.pptx
*.odt
*.ods
/*.pdf
/*.zip

# internal working notes for coding agents (kept on this machine only)
/AGENTS.md
/CLAUDE.md
/HANDOFF.md
/docs/QA-*.md
/tests/coverage/BRIEF.md

# log files of a dev server (KNIFE_LOG_DIR default <repo>/logs; src/lib/logs/core.mjs)
/logs/
